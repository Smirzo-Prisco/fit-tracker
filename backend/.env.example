PORT=4001

DB_HOST=127.0.0.1
DB_USER=fit_tracker
DB_PASSWORD=
DB_NAME=fit_tracker

# Dominio pubblico dell'app (usato da WebAuthn come RP ID e per CORS/cookie)
RP_ID=fit.crystaltokyo.it
RP_NAME=Fit Tracker
ORIGIN=https://fit.crystaltokyo.it

# Secret per firmare il cookie di sessione dopo il login WebAuthn
JWT_SECRET=cambia-questo-valore-con-una-stringa-lunga-e-casuale

# Secret una tantum per proteggere l'endpoint di enrollment della prima passkey
# (va cancellato / invalidato dopo il primo utilizzo)
SETUP_SECRET=cambia-questo-valore-con-una-stringa-lunga-e-casuale
