PORT=4001

DB_HOST=127.0.0.1
DB_USER=fit_tracker
DB_PASSWORD=
DB_NAME=fit_tracker

# Dominio pubblico dell'app (usato da WebAuthn come RP ID e per CORS/cookie)
RP_ID=fit.itacavilla.it
RP_NAME=Fit Tracker
ORIGIN=https://fit.itacavilla.it

# Secret per firmare il cookie di sessione dopo il login WebAuthn
JWT_SECRET=cambia-questo-valore-con-una-stringa-lunga-e-casuale

# Chiavi VAPID per le notifiche push (generabili con: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tuo@indirizzo.it
